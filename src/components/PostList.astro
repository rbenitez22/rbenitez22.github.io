---
import type { CollectionEntry } from 'astro:content';
import { buildPostHref, formatPublished } from '../lib/posts';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---
<ol class="post-list">
  {posts.map((post) => (
    <li class="post-list__item">
      <a class="post-list__title" href={buildPostHref(post)}>{post.data.title}</a>
      <p class="post-list__summary">{post.data.summary}</p>
      <p class="post-list__date">{formatPublished(post.data.published)}</p>
    </li>
  ))}
</ol>

<style>
  .post-list { list-style: none; padding: 0; margin: 0; }
  .post-list__item { padding: 1rem 0; border-bottom: 1px solid var(--surface-rule); }
  .post-list__item + .post-list__item { margin-top: 0; }
  .post-list__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
  }
  .post-list__summary { margin: 0.25rem 0; }
  .post-list__date {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
