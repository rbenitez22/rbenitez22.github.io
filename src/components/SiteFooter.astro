</footer>

<style>
  .site-footer {
    max-width: 68rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 2.5rem;
    border-top: 1px solid var(--surface-rule);
  }
  .site-footer__text {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
</style>
