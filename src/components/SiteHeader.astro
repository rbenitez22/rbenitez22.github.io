---
const links = [
  { href: '/', label: 'Work' },
  { href: '/conrad/', label: 'Conrad' },
];
const current = Astro.url.pathname;
---
<header class="site-header">
  <a class="site-header__name" href="/">Roberto Benitez</a>
  <nav class="site-header__nav" aria-label="Site">
    {links.map(({ href, label }) => (
      <a class="site-header__link" href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    max-width: 68rem;
    margin: 0 auto;
    padding: 1.25rem 1rem;
    border-bottom: 1px solid var(--surface-rule);
  }
  .site-header__name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--text-strong);
    text-decoration: none;
  }
  .site-header__nav { display: flex; gap: 1.25rem; }
  .site-header__link {
    font-family: var(--font-label);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
  }
  .site-header__link:hover,
  .site-header__link[aria-current='page'] { color: var(--accent); }
  @media (min-width: 48rem) {
    .site-header { padding: 1.5rem 2rem; }
  }
</style>
